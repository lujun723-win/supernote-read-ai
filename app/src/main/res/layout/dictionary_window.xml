<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dictionaryTextSelectionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dictionary_select_text"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#E8F4FD" />

        <Button
            android:id="@+id/dictionaryRegionOcrButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/dictionary_region_ocr"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#F0F0F0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/dictionaryQueryInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/dictionary_query_hint"
            android:singleLine="true"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="@drawable/input_border"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/dictionarySearchButton"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/dictionary_lookup"
            android:textSize="15sp"
            android:textColor="#000000"
            android:background="#E8F4FD" />

        <Button
            android:id="@+id/dictionaryCloseButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/close"
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="#F0F0F0" />
    </LinearLayout>

    <TextView
        android:id="@+id/dictionaryStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dictionary_ready"
        android:textSize="14sp"
        android:textColor="#333333" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#F8F8F8"
        android:fillViewport="true">

        <TextView
            android:id="@+id/dictionaryResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="17sp"
            android:textColor="#000000"
            android:textIsSelectable="true"
            android:lineSpacingExtra="5dp" />
    </ScrollView>
</LinearLayout>
